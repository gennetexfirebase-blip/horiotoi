  "contentHtml": "\n \n <div><!--IMG1--><img alt=\"\" src=\"https://web.archive.org/web/20131221152139im_/http://www.horiotoi.org/_nw/45/65664402.png\" loading=\"lazy\" decoding=\"async\"><!--IMG1--><br><div><!--[if gte mso 9]><xml><w:WordDocument><w:View>Normal</w:View><w:Zoom>0</w:Zoom><w:TrackMoves/><w:TrackFormatting/><w:PunctuationKerning/><w:ValidateAgainstSchemas/><w:SaveIfXMLInvalid>false</w:SaveIfXMLInvalid><w:IgnoreMixedContent>false</w:IgnoreMixedContent><w:AlwaysShowPlaceholderText>false</w:AlwaysShowPlaceholderText><w:DoNotPromoteQF/><w:LidThemeOther>EN-US</w:LidThemeOther><w:LidThemeAsian>X-NONE</w:LidThemeAsian><w:LidThemeComplexScript>X-NONE</w:LidThemeComplexScript><w:Compatibility><w:BreakWrappedTables/><w:SnapToGridInCell/><w:WrapTextWithPunct/><w:UseAsianBreakRules/><w:DontGrowAutofit/><w:SplitPgBreakAndParaMark/><w:DontVertAlignCellWithSp/><w:DontBreakConstrainedForcedTables/><w:DontVertAlignInTxbx/><w:Word11KerningPairs/><w:CachedColBalance/></w:Compatibility><w:BrowserLevel>MicrosoftInternetExplorer4</w:BrowserLevel><m:mathPr><m:mathFont m:val=\"Cambria Math\"/><m:brkBin m:val=\"before\"/><m:brkBinSub m:val=\"&#45;-\"/><m:smallFrac m:val=\"off\"/><m:dispDef/><m:lMargin m:val=\"0\"/><m:rMargin m:val=\"0\"/><m:defJc m:val=\"centerGroup\"/><m:wrapIndent m:val=\"1440\"/><m:intLim m:val=\"subSup\"/><m:naryLim m:val=\"undOvr\"/></m:mathPr></w:WordDocument></xml><![endif]--><p><span lang=\"MN\">Мэрилин Мэнсон </span>(<span lang=\"MN\">Брайан Уорнер</span>)<span lang=\"MN\"> дэлхий даяар 50 гаруй сая цомог борлуулсан рок од\nюм. Түүнийг 1990 –ээд оноос хойш хийсэн уран бүтээлүүд нь хүмүүсийн дунд үнэхээр\nШОК болохоор уран бүтээлүүдийг хийж хэвлэл мэдээлэлийнхэнээс үргэлж шүүмжлэл\nавч бас бусдыг айлгадаг байсан. Олон жилийн туршид хэвлэл мэдээлэлийнхэн түүний\nдуунуудыг болон клипүүдийг хүүхдүүдэд үзүүлж болохгүй хэмээн шуугиж ирсэн.\nМэнсоны продюсерлосон зарим нэгэн аймшигтай видео клипүүдийн нэг нь 2011 онд\nгарсан жүжигчин </span>Shia Labeouf <span lang=\"MN\">–тай хамтран </span>Born Villian <span lang=\"MN\">хэмээх видео хийсэн уг видео нь хүчирхийлэлийг маш их харуулсан юм. </span></p><p><span lang=\"MN\">Гэсэн хэдий ч\nМэрилин Мэнсоны хамгийн сенсаци болсон видео бол </span>Groupie <span lang=\"MN\">гэсэн нэртэй видео юм. Энэ нь түүний </span>AntiChrist\nSuperstar <span lang=\"MN\">аялалын тоглолт-н үед\nхийгдсэн видео бөгөөд <span>&nbsp;</span></span>(1996 -\n1998) <span lang=\"MN\">оны үед Мэрилин болон Твигги </span>(Jeordie\nWhite) <span lang=\"MN\">нар хамтлагийнхаа фэнийг\nтамлан зовоон видеог хийжээ.<span>&nbsp; </span>Тэд гартаа\nкамер бариад энэ бичлэг болно гэж хэлж эхэлдэг. Энэхүү видеон дээр хэсэгхэн\nгарах хэдий ч гэсэн тэрхүү охинд </span>Stephen Bier <span lang=\"MN\">өөрийнхөө шээсийг аяганд хийн уулгахыг тушаадаг\nбайна.<span>&nbsp; </span>Мэнсон хажуу талаас нь\nдаажигнахад хальс хар болж эхэлдэг. Видео цаашилах тусам үйл явдал нь ширүүн\nболж эхэлдэг. Энэхүү видео нь тарчлаан зовоохоос гадна цус урсгасан явдал\nбайлаа. <span>&nbsp;</span>Гэсэн хэдий ч энэхүү видео нь\nхамтлагийн </span>Dead to the world <span lang=\"MN\">видео цуврал байсан юм. Маш олон фэнүүд нь бас бусад хүмүүс гомдол мэдүүлж\nохиныг өмөөрсөн захидал тэдэнд ирэх болсон ч Мэрилин </span>\"<span lang=\"MN\">Есүс надад хайртай яагаад гэвэл би библи</span>”<span lang=\"MN\"> хэмээн хэлжээ. <br></span></p><p><br><span lang=\"MN\"></span></p><p><span lang=\"MN\"><br></span></p><!--[if gte mso 9]><xml><w:LatentStyles DefLockedState=\"false\" DefUnhideWhenUsed=\"true\"\n DefSemiHidden=\"true\" DefQFormat=\"false\" DefPriority=\"99\"\n LatentStyleCount=\"267\"><w:LsdException Locked=\"false\" Priority=\"0\" SemiHidden=\"false\"\n UnhideWhenUsed=\"false\" QFormat=\"true\" Name=\"Normal\"/><w:LsdException Locked=\"false\" Priority=\"9\" SemiHidden=\"false\"\n UnhideWhenUsed=\"false\" QFormat=\"true\" Name=\"heading 1\"/><w:LsdException Locked=\"false\" Priority=\"9\" QFormat=\"true\" Name=\"heading 2\"/><w:LsdException Locked=